{
  "name": "qanda-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-with-env.mjs --mode development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/run-with-env.mjs --mode test node --import tsx --test src/**/*.test.ts",
    "start": "node scripts/run-with-env.mjs --mode production node dist/server.js",
    "prisma:generate": "node scripts/run-with-env.mjs --mode production prisma generate",
    "prisma:migrate": "node scripts/run-with-env.mjs --mode development prisma migrate dev --name init",
    "prisma:push": "node scripts/run-with-env.mjs --mode development prisma db push",
    "seed": "node scripts/run-with-env.mjs --mode production tsx src/scripts/seedAdmin.ts",
    "import:legacy": "node scripts/run-with-env.mjs --mode production tsx src/scripts/importLegacyBanks.ts",
    "prisma:migrate:deploy": "node scripts/run-with-env.mjs --mode production prisma migrate deploy",
    "prisma:migrate:status": "node scripts/run-with-env.mjs --mode production prisma migrate status",
    "prisma:generate:dev": "node scripts/run-with-env.mjs --mode development prisma generate",
    "prisma:push:dev": "node scripts/run-with-env.mjs --mode development prisma db push",
    "prisma:migrate:dev": "node scripts/run-with-env.mjs --mode development prisma migrate dev --name init",
    "seed:dev": "node scripts/run-with-env.mjs --mode development tsx src/scripts/seedAdmin.ts",
    "import:legacy:dev": "node scripts/run-with-env.mjs --mode development tsx src/scripts/importLegacyBanks.ts",
    "normalize:judge": "node scripts/run-with-env.mjs --mode production tsx src/scripts/normalizeJudgeQuestions.ts",
    "normalize:judge:dev": "node scripts/run-with-env.mjs --mode development tsx src/scripts/normalizeJudgeQuestions.ts",
    "audit:answers": "node scripts/run-with-env.mjs --mode production tsx src/scripts/auditAnswerCompatibility.ts",
    "audit:answers:dev": "node scripts/run-with-env.mjs --mode development tsx src/scripts/auditAnswerCompatibility.ts",
    "practice-answer-queue:cleanup": "node scripts/run-with-env.mjs --mode production tsx src/scripts/cleanupPracticeAnswerQueue.ts",
    "practice-answer-queue:cleanup:dev": "node scripts/run-with-env.mjs --mode development tsx src/scripts/cleanupPracticeAnswerQueue.ts",
    "test:integration": "node scripts/run-with-env.mjs --mode test node --test tests/mysql.integration.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
