{
  "name": "qanda-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-with-env.mjs tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "seed": "tsx src/scripts/seedAdmin.ts",
    "import:legacy": "tsx src/scripts/importLegacyBanks.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:generate:dev": "node scripts/run-with-env.mjs prisma generate",
    "prisma:push:dev": "node scripts/run-with-env.mjs prisma db push",
    "prisma:migrate:dev": "node scripts/run-with-env.mjs prisma migrate dev --name init",
    "seed:dev": "node scripts/run-with-env.mjs tsx src/scripts/seedAdmin.ts",
    "import:legacy:dev": "node scripts/run-with-env.mjs tsx src/scripts/importLegacyBanks.ts",
    "normalize:judge": "tsx src/scripts/normalizeJudgeQuestions.ts",
    "normalize:judge:dev": "node scripts/run-with-env.mjs tsx src/scripts/normalizeJudgeQuestions.ts",
    "practice-answer-queue:cleanup": "tsx src/scripts/cleanupPracticeAnswerQueue.ts",
    "practice-answer-queue:cleanup:dev": "node scripts/run-with-env.mjs tsx src/scripts/cleanupPracticeAnswerQueue.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
