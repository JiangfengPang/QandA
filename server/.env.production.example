# 服务器生产后端配置示例
# 部署到服务器时复制为 /opt/qanda/server/.env 后再填写真实值。
# 不要覆盖服务器已有 /opt/qanda/server/.env，除非你明确知道自己在做什么。
NODE_ENV="production"
PORT=3000

JWT_SECRET="请填写32位以上随机字符串"

# 当前公网 IP + HTTP 模式示例：
CORS_ORIGIN="http://127.0.0.1,http://127.0.0.1:8080,http://localhost,http://localhost:8080,http://49.232.193.110,http://49.232.193.110:8080"

COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=""
TRUST_PROXY=true

DATABASE_URL="mysql://root:你的MySQL密码@127.0.0.1:3306/qanda"

ADMIN_USERNAME="tim_admin"
ADMIN_PASSWORD="请填写后台管理员密码"
ADMIN_EMAIL=""

APP_NAME="QandA 刷题系统"
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="你的QQ邮箱"
SMTP_PASS="你的QQ邮箱授权码"
SMTP_FROM="你的QQ邮箱"

UPLOAD_DIR="/var/www/qanda/uploads"
IP_HTTP_MODE=true

# 答题提交队列：高并发时建议保持启用，按服务器/数据库能力调节消费速度。
PRACTICE_ANSWER_QUEUE_ENABLED=true
PRACTICE_ANSWER_QUEUE_BATCH_SIZE=25
PRACTICE_ANSWER_QUEUE_CONCURRENCY=1
PRACTICE_ANSWER_QUEUE_POLL_MS=1000
PRACTICE_ANSWER_QUEUE_MAX_ATTEMPTS=8
PRACTICE_REVIEW_SUMMARY_CACHE_SECONDS=10

# 在线人数心跳与统计缓存。
PRESENCE_HEARTBEAT_INTERVAL_MS=120000
PRESENCE_ONLINE_WINDOW_SECONDS=300
PRESENCE_MIN_WRITE_INTERVAL_SECONDS=60
PRESENCE_COUNT_CACHE_SECONDS=15
